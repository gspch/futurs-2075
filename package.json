{
  "name": "aiguillages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aiguillages — jeu sur les futurs possibles 2025-2075 : moteur, bots, simulateur, jeu web.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx simulateur/src/cli.ts",
    "sim:final": "tsx simulateur/src/cli.ts rapport --parties 10000 --graine 2075",
    "sim:ci": "tsx simulateur/src/cli.ts ci --parties 50 --graine 7",
    "adverse": "tsx simulateur/src/cli.ts adverse",
    "dev": "node outils/copier-pdf.mjs && vite web",
    "build": "node outils/copier-pdf.mjs && vite build web",
    "pdf": "tsx outils/pdf.ts",
    "graphiques": "tsx outils/graphiques.ts",
    "rapport": "tsx outils/rapport.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.17.1",
    "marked": "^14.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
